@startchen entities_and_attributes

' Core business entities

entity Company {
    Company_id <<key>>
    Name
    Address {
        Street
        Number
        Postal_code
        Neighborhood
        City
        State
    }
    Phone <<multi>>
    Website
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity User {
    User_id <<key>>
    Company_id
    Email
    Password_hash
    Profile {
        First_name
        Last_name
        Avatar_url
    }
    Phone <<multi>>
    Role
    Status {
        Email_verified
        Is_active
        Last_login_at
    }
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Contact {
    Contact_id <<key>>
    Company_id
    Type
    Name {
        First_name
        Last_name
    }
    Email
    Phone <<multi>>
    Work_info {
        Company_name
        Job_title
        Department
    }
    Source
    Status
    Address {
        Street
        City
        Country
    }
    Notes
    Tags
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Deal {
    Deal_id <<key>>
    Company_id
    Contact_id
    Owner_user_id
    Name
    Description
    Financials {
        Value
        Currency
        Probability
    }
    Timeline {
        Expected_close_date
        Actual_close_date
    }
    Stage
    Status
    Loss_reason
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Product {
    Product_id <<key>>
    Company_id
    Type
    Name
    Description
    Sku
    Category
    Pricing {
        Price
        Cost
        Currency
        Tax_rate
    }
    Is_active
    Track_inventory
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Service {
    Service_id <<key>>
    Company_id
    Name
    Description
    Pricing {
        Price
        Cost
        Currency
    }
    Duration
    Category
    Is_active
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Invoice {
    Invoice_id <<key>>
    Company_id
    Contact_id
    Invoice_number
    Type
    Status
    Dates {
        Issue_date
        Due_date
        Paid_date
    }
    Amounts {
        Subtotal
        Tax_amount
        Total_amount
        Currency
    }
    Notes
    Terms_and_conditions
    Idempotency_key
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

' Subscription & Billing entities

entity Plan {
    Plan_id <<key>>
    Name
    Pricing {
        Price_monthly
        Price_yearly
    }
    Features
    Limits
    Is_active
    Created_at
}

entity Subscription {
    Subscription_id <<key>>
    Company_id
    Plan_id
    Plan_details {
        Plan_name
        Price
        Currency
        Billing_cycle
    }
    Status
    Timeline {
        Start_date
        End_date
        Next_billing_date
    }
    Stripe_subscription_id
    Idempotency_key
    Created_at
}

' Financial management entities

entity Revenue {
    Revenue_id <<key>>
    Company_id
    Contact_id
    Invoice_id
    Description
    Amount
    Revenue_date
    Category
    Cost_center_id
    Relationship_record {
        Created_at
        Deleted_at
    }
}

entity RevenueCategory {
    Category_id <<key>>
    Company_id
    Name
    Description
    Is_active
    Created_at
}

entity Expense {
    Expense_id <<key>>
    Company_id
    Description
    Category
    Amount
    Expense_date
    Vendor
    Payment_method
    Status
    Cost_center_id
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity ExpenseCategory {
    Category_id <<key>>
    Company_id
    Name
    Description
    Is_active
    Created_at
}

entity CostCenter {
    Cost_center_id <<key>>
    Company_id
    Name
    Description
    Budgeting {
        Budget
        Actual_spend
    }
    Color
    Is_active
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity FinancialTransaction {
    Transaction_id <<key>>
    Company_id
    Transaction_type
    Related_entity {
        Type
        Id
    }
    Amount
    Timeline {
        Due_date
        Paid_date
    }
    Status
    Bank_account_id
    Cost_center_id
    Relationship_record {
        Created_at
        Updated_at
    }
}

' Client lifecycle management

entity ClientApplication {
    Application_id <<key>>
    Company_id
    Contact_id
    Applicant_info {
        First_name
        Last_name
        Email
        Phone <<multi>>
        Cpf
        Cnpj
    }
    Company_info {
        Company_age
        Company_size
        Segment
        Revenue
        Has_physical_location
    }
    Credit_purpose
    Notes
    Status
    Converted_at
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity CreditAnalysis {
    Analysis_id <<key>>
    Company_id
    Client_application_id
    Analyst_user_id
    Analysis_result {
        Risk_score
        Approved_amount
        Interest_rate
        Justification
    }
    Status
    Created_at
}

' Contract & legal entities

entity Contract {
    Contract_id <<key>>
    Company_id
    Contact_id
    Terms {
        Total_value
        Interest_rate
        Installment_count
    }
    Timeline {
        Start_date
        End_date
    }
    Status
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity ContractInstallment {
    Installment_id <<key>>
    Contract_id
    Installment_number
    Amount
    Status
    Late_fee
    Timeline {
        Due_date
        Paid_date
    }
    Created_at
}

' Banking & cash flow

entity BankAccount {
    Bank_account_id <<key>>
    Company_id
    Bank_name
    Account_details {
        Agency
        Account_number
        Account_type
    }
    Balance
    Is_active
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity BankStatementEntry {
    Entry_id <<key>>
    Bank_account_id
    Transaction_date
    Description
    Amount
    Transaction_type
    Balance_after
    Reference_number
    Created_at
}

entity Payment {
    Payment_id <<key>>
    Company_id
    Contract_installment_id
    Bank_account_id
    Amount
    Payment_date
    Payment_method
    Reference_number
    Status
    Idempotency_key
    Created_at
}

' Document management

entity Document {
    Document_id <<key>>
    Company_id
    Host_entity {
        Entity_type
        Entity_id
    }
    Document_type
    File_info {
        File_name
        File_path
        File_size
        Mime_type
    }
    Storage_info {
        Storage_provider
        Bucket
        Checksum
    }
    Version
    Audit {
        Uploaded_by
        Uploaded_at
        Expires_at
        Deleted_at
    }
}

' Operational management

entity CalendarEvent {
    Event_id <<key>>
    Company_id
    Title
    Description
    Timeline {
        Start_time
        End_time
    }
    Related_entity {
        Entity_type
        Entity_id
    }
    Created_by
    Reminder_sent
    Status
    Created_at
}

entity Task {
    Task_id <<key>>
    Company_id
    Assigned_to
    Title
    Description
    Due_date
    Priority
    Status
    Related_entity {
        Entity_type
        Entity_id
    }
    Completed_at
    Relationship_record {
        Created_at
        Deleted_at
    }
}

entity Activity {
    Activity_id <<key>>
    Company_id
    User_id
    Contact_id
    Deal_id
    Type
    Subject
    Description
    Content
    Timeline {
        Due_date
        Completed_date
    }
    Status
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

' Inventory & sales operations

entity Sale {
    Sale_id <<key>>
    Company_id
    Contact_id
    Total_amount
    Sale_date
    Status
    Payment_terms
    Relationship_record {
        Created_at
        Deleted_at
    }
}

entity SaleItem {
    Sale_item_id <<key>>
    Sale_id
    Item {
        Product_id
        Service_id
    }
    Quantity
    Pricing {
        Unit_price
        Total_amount
    }
    Created_at
}

entity InventoryMovement {
    Movement_id <<key>>
    Company_id
    Product_id
    Movement_type
    Quantity
    Unit_cost
    Reference_id
    Notes
    Created_at
}

' System & administration

entity AuditLog {
    Log_id <<key>>
    Company_id
    User_id
    Action
    Target_entity {
        Entity_type
        Entity_id
    }
    Changes {
        Old_values
        New_values
    }
    Request_info {
        Ip_address
        User_agent
    }
    Timestamp
}

entity UserRole {
    Role_id <<key>>
    Company_id
    Name
    Permissions
    Is_system_role
    Created_at
}

entity Integration {
    Integration_id <<key>>
    Company_id
    Service_name
    Credentials {
        Api_key
        Config_data
    }
    Is_active
    Last_sync_at
    Created_at
}

entity Notification {
    Notification_id <<key>>
    Company_id
    User_id
    Title
    Message
    Type
    Is_read
    Action_url
    Created_at
}

' Authentication & security

entity Session {
    Session_id <<key>>
    User_id
    Expires_at
    Created_at
}

entity PasswordResetToken {
    Token_id <<key>>
    User_id
    Token
    Timeline {
        Expires_at
        Used_at
    }
    Created_at
}

entity EmailVerificationToken {
    Token_id <<key>>
    User_id
    Token
    Timeline {
        Expires_at
        Used_at
    }
    Created_at
}

entity OAuthAccount {
    Oauth_account_id <<key>>
    User_id
    Provider_info {
        Provider
        Provider_user_id
    }
    Token_info {
        Access_token
        Refresh_token
        Expires_at
    }
    Relationship_record {
        Created_at
        Updated_at
    }
}

entity TwoFactor {
    Two_factor_id <<key>>
    User_id
    Totp_secret
    Backup_codes
    Enabled_at
    Created_at
}

' Webhooks & jobs

entity WebhookEndpoint {
    Endpoint_id <<key>>
    Company_id
    Url
    Event_types
    Secret
    Is_active
    Created_at
}

entity WebhookDelivery {
    Delivery_id <<key>>
    Endpoint_id
    Event_name
    Payload
    Retry_policy {
        Attempt
        Next_retry_at
    }
    Status
    Error
    Idempotency_key
    Created_at
}

entity JobQueue {
    Job_id <<key>>
    Type
    Payload
    Run_at
    Attempts
    Status
    Last_error
    Relationship_record {
        Created_at
        Updated_at
    }
}

' Settings & configuration

entity CompanySettings {
    Company_id <<key>>
    Legal_info {
        Razao_social
        Cnpj
    }
    Contact_info {
        Endereco
        Telefone
    }
    Branding {
        Logo_ref
        Theme_settings
    }
    Settings {
        Security_settings
        Integration_settings
    }
    Created_at
}

entity TenantSetting {
    Setting_id <<key>>
    Company_id
    Setting_key
    Setting_value
    Data_type
    Updated_at
}

entity EmailTemplate {
    Template_id <<key>>
    Company_id
    Name
    Content {
        Subject
        Body
    }
    Variables
    Is_active
    Created_at
}

' Reporting & analytics

entity ReportSchedule {
    Schedule_id <<key>>
    Company_id
    Report_type
    Frequency
    Parameters
    Timeline {
        Last_run_at
        Next_run_at
    }
    Is_active
    Created_at
}

entity KPI {
    Kpi_id <<key>>
    Company_id
    Name
    Calculation_query
    Values {
        Target_value
        Current_value
    }
    Period
    Updated_at
}

' Multi-tenancy support

entity CompanyDomain {
    Domain_id <<key>>
    Company_id
    Domain_name
    Is_primary
    Verified_at
    Created_at
}

@endchen
