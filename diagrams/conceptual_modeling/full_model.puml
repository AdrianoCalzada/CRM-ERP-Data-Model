@startchen full_conceptual_model

' Core business entities

entity Company {
    Company_id <<key>>
    Name
    Address {
        Street
        Number
        Postal_code
        Neighborhood
        City
        State
    }
    Phone <<multi>>
    Website
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity User {
    User_id <<key>>
    Company_id
    Email
    Password_hash
    Profile {
        First_name
        Last_name
        Avatar_url
    }
    Phone <<multi>>
    Role
    Status {
        Email_verified
        Is_active
        Last_login_at
    }
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Contact {
    Contact_id <<key>>
    Company_id
    Type
    Name {
        First_name
        Last_name
    }
    Email
    Phone <<multi>>
    Work_info {
        Company_name
        Job_title
        Department
    }
    Source
    Status
    Address {
        Street
        City
        Country
    }
    Notes
    Tags
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Deal {
    Deal_id <<key>>
    Company_id
    Contact_id
    Owner_user_id
    Name
    Description
    Financials {
        Value
        Currency
        Probability
    }
    Timeline {
        Expected_close_date
        Actual_close_date
    }
    Stage
    Status
    Loss_reason
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Product {
    Product_id <<key>>
    Company_id
    Type
    Name
    Description
    Sku
    Category
    Pricing {
        Price
        Cost
        Currency
        Tax_rate
    }
    Is_active
    Track_inventory
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Service {
    Service_id <<key>>
    Company_id
    Name
    Description
    Pricing {
        Price
        Cost
        Currency
    }
    Duration
    Category
    Is_active
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity Invoice {
    Invoice_id <<key>>
    Company_id
    Contact_id
    Invoice_number
    Type
    Status
    Dates {
        Issue_date
        Due_date
        Paid_date
    }
    Amounts {
        Subtotal
        Tax_amount
        Total_amount
        Currency
    }
    Notes
    Terms_and_conditions
    Idempotency_key
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity EmailVerificationToken {
    Token_id <<key>>
    User_id
    Token
    Timeline {
        Expires_at
        Used_at
    }
    Created_at
}
' Subscription & Billing entities

entity Plan {
    Plan_id <<key>>
    Name
    Pricing {
        Price_monthly
        Price_yearly
    }
    Features
    Limits
    Is_active
    Created_at
}

entity Subscription {
    Subscription_id <<key>>
    Company_id
    Plan_id
    Plan_details {
        Plan_name
        Price
        Currency
        Billing_cycle
    }
    Status
    Timeline {
        Start_date
        End_date
        Next_billing_date
    }
    Stripe_subscription_id
    Idempotency_key
    Created_at
}

' Financial management entities

entity Revenue {
    Revenue_id <<key>>
    Company_id
    Contact_id
    Invoice_id
    Description
    Amount
    Revenue_date
    Category
    Cost_center_id
    Relationship_record {
        Created_at
        Deleted_at
    }
}

entity RevenueCategory {
    Category_id <<key>>
    Company_id
    Name
    Description
    Is_active
    Created_at
}

entity Expense {
    Expense_id <<key>>
    Company_id
    Description
    Category
    Amount
    Expense_date
    Vendor
    Payment_method
    Status
    Cost_center_id
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity ExpenseCategory {
    Category_id <<key>>
    Company_id
    Name
    Description
    Is_active
    Created_at
}

entity CostCenter {
    Cost_center_id <<key>>
    Company_id
    Name
    Description
    Budgeting {
        Budget
        Actual_spend
    }
    Color
    Is_active
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

' Client lifecycle management

entity ClientApplication {
    Application_id <<key>>
    Company_id
    Contact_id
    Applicant_info {
        First_name
        Last_name
        Email
        Phone <<multi>>
        Cpf
        Cnpj
    }
    Company_info {
        Company_age
        Company_size
        Segment
        Revenue
        Has_physical_location
    }
    Credit_purpose
    Notes
    Status
    Converted_at
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity CreditAnalysis {
    Analysis_id <<key>>
    Company_id
    Client_application_id
    Analyst_user_id
    Analysis_result {
        Risk_score
        Approved_amount
        Interest_rate
        Justification
    }
    Status
    Created_at
}

' Contract & legal entities

entity Contract {
    Contract_id <<key>>
    Company_id
    Contact_id
    Terms {
        Total_value
        Interest_rate
        Installment_count
    }
    Timeline {
        Start_date
        End_date
    }
    Status
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity ContractInstallment {
    Installment_id <<key>>
    Contract_id
    Installment_number
    Amount
    Status
    Late_fee
    Timeline {
        Due_date
        Paid_date
    }
    Created_at
}

' Banking & cash flow

entity BankAccount {
    Bank_account_id <<key>>
    Company_id
    Bank_name
    Account_details {
        Agency
        Account_number
        Account_type
    }
    Balance
    Is_active
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

entity BankStatementEntry {
    Entry_id <<key>>
    Bank_account_id
    Transaction_date
    Description
    Amount
    Transaction_type
    Balance_after
    Reference_number
    Created_at
}

entity Payment {
    Payment_id <<key>>
    Company_id
    Contract_installment_id
    Bank_account_id
    Amount
    Payment_date
    Payment_method
    Reference_number
    Status
    Idempotency_key
    Created_at
}

' Document management

entity Document {
    Document_id <<key>>
    Company_id
    Host_entity {
        Entity_type
        Entity_id
    }
    Document_type
    File_info {
        File_name
        File_path
        File_size
        Mime_type
    }
    Storage_info {
        Storage_provider
        Bucket
        Checksum
    }
    Version
    Audit {
        Uploaded_by
        Uploaded_at
        Expires_at
        Deleted_at
    }
}

' Operational management

entity CalendarEvent {
    Event_id <<key>>
    Company_id
    Title
    Description
    Timeline {
        Start_time
        End_time
    }
    Related_entity {
        Entity_type
        Entity_id
    }
    Created_by
    Reminder_sent
    Status
    Created_at
}

entity Task {
    Task_id <<key>>
    Company_id
    Assigned_to
    Title
    Description
    Due_date
    Priority
    Status
    Related_entity {
        Entity_type
        Entity_id
    }
    Completed_at
    Relationship_record {
        Created_at
        Deleted_at
    }
}

entity Activity {
    Activity_id <<key>>
    Company_id
    User_id
    Contact_id
    Deal_id
    Type
    Subject
    Description
    Content
    Timeline {
        Due_date
        Completed_date
    }
    Status
    Related_entity {
        Entity_type
        Entity_id
    }
    Relationship_record {
        Created_at
        Updated_at
        Deleted_at
    }
}

' Iventory & sales operations

entity Sale {
    Sale_id <<key>>
    Company_id
    Contact_id
    Total_amount
    Sale_date
    Status
    Payment_terms
    Relationship_record {
        Created_at
        Deleted_at
    }
}

entity SaleItem {
    Sale_item_id <<key>>
    Sale_id
    Item {
        Product_id
        Service_id
    }
    Quantity
    Pricing {
        Unit_price
        Total_amount
    }
    Created_at
}

entity InventoryMovement {
    Movement_id <<key>>
    Company_id
    Product_id
    Movement_type
    Quantity
    Unit_cost
    Reference_id
    Notes
    Created_at
}

' System & administration

entity AuditLog {
    Log_id <<key>>
    Company_id
    User_id
    Action
    Target_entity {
        Entity_type
        Entity_id
    }
    Changes {
        Old_values
        New_values
    }
    Request_info {
        Ip_address
        User_agent
    }
    Timestamp
}

entity UserRole {
    Role_id <<key>>
    Company_id
    Name
    Permissions
    Is_system_role
    Created_at
}

entity Integration {
    Integration_id <<key>>
    Company_id
    Service_name
    Credentials {
        Api_key
        Config_data
    }
    Is_active
    Last_sync_at
    Created_at
}

entity Notification {
    Notification_id <<key>>
    Company_id
    User_id
    Title
    Message
    Type
    Is_read
    Action_url
    Created_at
}

' Authentication & security

entity Session {
    Session_id <<key>>
    User_id
    Expires_at
    Created_at
}

entity PasswordResetToken {
    Token_id <<key>>
    User_id
    Token
    Timeline {
        Expires_at
        Used_at
    }
    Created_at
}

entity OAuthAccount {
    Oauth_account_id <<key>>
    User_id
    Provider_info {
        Provider
        Provider_user_id
    }
    Token_info {
        Access_token
        Refresh_token
        Expires_at
    }
    Relationship_record {
        Created_at
        Updated_at
    }
}

entity TwoFactor {
    Two_factor_id <<key>>
    User_id
    Totp_secret
    Backup_codes
    Enabled_at
    Created_at
}

' Webhooks & jobs

entity WebhookEndpoint {
    Endpoint_id <<key>>
    Company_id
    Url
    Event_types
    Secret
    Is_active
    Created_at
}

entity WebhookDelivery {
    Delivery_id <<key>>
    Endpoint_id
    Event_name
    Payload
    Retry_policy {
        Attempt
        Next_retry_at
    }
    Status
    Error
    Idempotency_key
    Created_at
}

entity JobQueue {
    Job_id <<key>>
    Type
    Payload
    Run_at
    Attempts
    Status
    Last_error
    Relationship_record {
        Created_at
        Updated_at
    }
}

' Settings & configuration

entity CompanySettings {
    Company_id <<key>>
    Legal_info {
        Razao_social
        Cnpj
    }
    Contact_info {
        Endereco
        Telefone
    }
    Branding {
        Logo_ref
        Theme_settings
    }
    Settings {
        Security_settings
        Integration_settings
    }
    Updated_at
}

entity TenantSetting {
    setting_id <<key>>
    company_id
    setting_key
    setting_value
    data_type
    updated_at
}

entity EmailTemplate {
    Template_id <<key>>
    Company_id
    Name
    Content {
        Subject
        Body
    }
    Variables
    Is_active
    Created_at
}

' Reporting & analytics

entity ReportSchedule {
    Schedule_id <<key>>
    Company_id
    Report_type
    Frequency
    Parameters
    Timeline {
        Last_run_at
        Next_run_at
    }
    Is_active
    Created_at
}

entity KPI {
    Kpi_id <<key>>
    Company_id
    Name
    Calculation_query
    Values {
        Target_value
        Current_value
    }
    Period
    Updated_at
}

' Multi-tenancy support

entity CompanyDomain {
    Domain_id <<key>>
    Company_id
    Domain_name
    Is_primary
    Verified_at
    Created_at
}

' Relationships

relationship CompanyHasUser {
}
Company -(1,1)- CompanyHasUser
CompanyHasUser -(1,M)- User

relationship CompanyHasCompanySettings {
}
Company -(1,1)- CompanyHasCompanySettings
CompanyHasCompanySettings -(1,1)- CompanySettings

relationship CompanyHasTenantSetting {
}
Company -(1,1)- CompanyHasTenantSetting
CompanyHasTenantSetting -(1,M)- TenantSetting

relationship CompanyHasCompanyDomain {
}
Company -(1,1)- CompanyHasCompanyDomain
CompanyHasCompanyDomain -(1,M)- CompanyDomain

relationship UserHasSession {
}
User -(1,1)- UserHasSession
UserHasSession -(1,M)- Session

relationship UserHasOAuthAccount {
}
User -(1,1)- UserHasOAuthAccount
UserHasOAuthAccount -(1,M)- OAuthAccount

relationship UserHasTwoFactor {
}
User -(0,1)- UserHasTwoFactor
UserHasTwoFactor -(1,1)- TwoFactor

relationship UserHasPasswordResetToken {
}
User -(1,1)- UserHasPasswordResetToken
UserHasPasswordResetToken -(1,M)- PasswordResetToken

relationship UserHasEmailVerificationToken {
}
User -(1,1)- UserHasEmailVerificationToken
UserHasEmailVerificationToken -(1,M)- EmailVerificationToken

relationship UserHasRoleAssignment {
}
User -(M,N)- UserHasRoleAssignment
UserHasRoleAssignment -(M,N)- UserRole

relationship CompanyHasContact {
}
Company -(1,1)- CompanyHasContact
CompanyHasContact -(1,M)- Contact

relationship ContactHasDeal {
}
Contact -(1,1)- ContactHasDeal
ContactHasDeal -(1,M)- Deal

relationship UserOwnsDeal {
}
User -(1,1)- UserOwnsDeal
UserOwnsDeal -(1,M)- Deal

relationship ContactHasActivity {
}
Contact -(1,1)- ContactHasActivity
ContactHasActivity -(1,M)- Activity

relationship DealHasActivity {
}
Deal -(1,1)- DealHasActivity
DealHasActivity -(1,M)- Activity

relationship UserActsInActivity {
}
User -(1,1)- UserActsInActivity
UserActsInActivity -(1,M)- Activity

relationship ContactHasInvoice {
}
Contact -(1,1)- ContactHasInvoice
ContactHasInvoice -(1,M)- Invoice

relationship CompanyHasProduct {
}
Company -(1,1)- CompanyHasProduct
CompanyHasProduct -(1,M)- Product

relationship CompanyHasService {
}
Company -(1,1)- CompanyHasService
CompanyHasService -(1,M)- Service

relationship SaleHasSaleItem {
}
Sale -(1,1)- SaleHasSaleItem
SaleHasSaleItem -(1,M)- SaleItem

relationship ContactHasSale {
}
Contact -(1,1)- ContactHasSale
ContactHasSale -(1,M)- Sale

relationship ProductReferencedInSaleItem {
}
Product -(1,1)- ProductReferencedInSaleItem
ProductReferencedInSaleItem -(1,M)- SaleItem

relationship ServiceReferencedInSaleItem {
}
Service -(1,1)- ServiceReferencedInSaleItem
ServiceReferencedInSaleItem -(1,M)- SaleItem

relationship ProductHasInventoryMovement {
}
Product -(1,1)- ProductHasInventoryMovement
ProductHasInventoryMovement -(1,M)- InventoryMovement

relationship ContactSignsContract {
}
Contact -(1,1)- ContactSignsContract
ContactSignsContract -(1,M)- Contract

relationship ContractHasInstallment {
}
Contract -(1,1)- ContractHasInstallment
ContractHasInstallment -(1,M)- ContractInstallment

relationship InstallmentReceivesPayment {
}
ContractInstallment -(0,1)- InstallmentReceivesPayment
InstallmentReceivesPayment -(1,M)- Payment

relationship BankAccountSettlesPayment {
}
BankAccount -(1,1)- BankAccountSettlesPayment
BankAccountSettlesPayment -(1,M)- Payment

relationship PlanHasSubscription {
}
Plan -(1,1)- PlanHasSubscription
PlanHasSubscription -(1,M)- Subscription

relationship CompanyHasSubscription {
}
Company -(1,1)- CompanyHasSubscription
CompanyHasSubscription -(1,M)- Subscription

relationship InvoiceGeneratesRevenue {
}
Invoice -(0,1)- InvoiceGeneratesRevenue
InvoiceGeneratesRevenue -(1,M)- Revenue

relationship RevenueCategorizedByCategory {
}
RevenueCategory -(1,1)- RevenueCategorizedByCategory
RevenueCategorizedByCategory -(1,M)- Revenue

relationship RevenueAllocatedToCostCenter {
}
CostCenter -(1,1)- RevenueAllocatedToCostCenter
RevenueAllocatedToCostCenter -(1,M)- Revenue

relationship ExpenseCategorizedByCategory {
}
ExpenseCategory -(1,1)- ExpenseCategorizedByCategory
ExpenseCategorizedByCategory -(1,M)- Expense

relationship ExpenseAllocatedToCostCenter {
}
CostCenter -(1,1)- ExpenseAllocatedToCostCenter
ExpenseAllocatedToCostCenter -(1,M)- Expense

relationship CompanyHasBankAccount {
}
Company -(1,1)- CompanyHasBankAccount
CompanyHasBankAccount -(1,M)- BankAccount

relationship BankAccountHasStatementEntry {
}
BankAccount -(1,1)- BankAccountHasStatementEntry
BankAccountHasStatementEntry -(1,M)- BankStatementEntry

relationship CompanyHasIntegration {
}
Company -(1,1)- CompanyHasIntegration
CompanyHasIntegration -(1,M)- Integration

relationship CompanyHasWebhookEndpoint {
}
Company -(1,1)- CompanyHasWebhookEndpoint
CompanyHasWebhookEndpoint -(1,M)- WebhookEndpoint

relationship WebhookEndpointHasDelivery {
}
WebhookEndpoint -(1,1)- WebhookEndpointHasDelivery
WebhookEndpointHasDelivery -(1,M)- WebhookDelivery

relationship CompanyRunsJob {
}
Company -(1,1)- CompanyRunsJob
CompanyRunsJob -(0,M)- JobQueue

relationship CompanyHasNotification {
}
Company -(1,1)- CompanyHasNotification
CompanyHasNotification -(1,M)- Notification

relationship UserHasNotification {
}
User -(1,1)- UserHasNotification
UserHasNotification -(1,M)- Notification

relationship CompanyHasReportSchedule {
}
Company -(1,1)- CompanyHasReportSchedule
CompanyHasReportSchedule -(1,M)- ReportSchedule

relationship CompanyHasKPI {
}
Company -(1,1)- CompanyHasKPI
CompanyHasKPI -(1,M)- KPI

' Polymorphic attachment relationships (host entity -> artifact)
relationship HostHasDocument {
}
relationship HostHasCalendarEvent {
}
relationship HostHasTask {
}
relationship HostHasActivityArtifact {
}

@endchen